{
  "name": "@tekmidian/clickr",
  "version": "0.1.0",
  "description": "Clickr — macOS screen measurement and input control MCP for Claude Code. Screenshot any display, click any global coordinate, type into any application.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "clickr": "dist/index.js"
  },
  "files": [
    "dist",
    "native",
    "scripts/build-native.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bash scripts/build-native.sh && tsc",
    "build:native": "bash scripts/build-native.sh",
    "build:ts": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node scripts/smoke-test.mjs",
    "test:functional": "node scripts/functional-test.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "claude",
    "claude-code",
    "macos",
    "automation",
    "screenshot",
    "computer-use",
    "accessibility",
    "cgevent",
    "clickr-mcp"
  ],
  "author": "Matthias Nott",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnott/Clickr.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
